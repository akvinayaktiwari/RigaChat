# Copy to .test.env at the repo root and fill in. Gitignored — it holds a
# Cognito idToken and a Meta access token, both live credentials.
#
#   cp scripts/test-meta-journey-run.env.example .test.env

AWS_REGION=ap-south-1

# Use the same origin the dashboard uses, so anything cookie- or CORS-shaped
# behaves the way it does in the product (see TODOS.md on the two-API-host gap).
API_BASE=https://vyostra.com

# Cognito idToken for the test client. Sign in to the dashboard, then in the
# browser console: sessionStorage.getItem('idToken')
# It expires in ONE HOUR and nothing refreshes it — if a phase suddenly starts
# returning 401s mid-run, this is why, not the journey.
ID_TOKEN=

# Cognito sub of that same client, and the bot bound to its Agent.
CLIENT_ID=
BOT_ID=

# A real handset you are physically holding, E.164. Turns 2 and 3 need someone
# to reply from it.
LEAD_PHONE=+91
LEAD_NAME=Journey Seam Test

# Optional but strongly recommended: without these, preflight cannot check that
# lead_welcome_qualify_1 and lead_followup_nudge_1 are APPROVED on the Meta
# WABA, and a missing template shows up as "greet silently never arrived".
WABA_ID=
META_TOKEN=

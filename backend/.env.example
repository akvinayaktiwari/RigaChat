# OpenAI API key used for embeddings (text-embedding-3-small) and chat completions (gpt-4o-mini)
OPENAI_API_KEY=

# Pinecone API key used for vector storage/retrieval of RAG embeddings
PINECONE_API_KEY=

# Name of the Pinecone index used for RAG embeddings
PINECONE_INDEX_NAME=

# AWS region for DynamoDB, Cognito, and Lambda resources
AWS_REGION=

# DynamoDB table name for clients (partition key: clientId)
DYNAMODB_TABLE_CLIENTS=

# DynamoDB table name for bots (partition key: clientId, sort key: botId)
DYNAMODB_TABLE_BOTS=

# DynamoDB table name for leads (partition key: botId, sort key: createdAt)
DYNAMODB_TABLE_LEADS=

# DynamoDB table name for conversations (partition key: botId, sort key: conversationId)
DYNAMODB_TABLE_CONVERSATIONS=

# DynamoDB table name for knowledge base entries (partition key: botId, sort key: entryId)
DYNAMODB_TABLE_KB=

# DynamoDB table name for forms (partition key: clientId, sort key: formId, GSI: formId-index)
DYNAMODB_TABLE_FORMS=

# DynamoDB table name for form leads (partition key: formId, sort key: leadId, GSIs: clientId-index, leadId-index)
DYNAMODB_TABLE_FORM_LEADS=

# DynamoDB table name for subscriptions (partition key: accountId)
DYNAMODB_TABLE_SUBSCRIPTIONS=

# DynamoDB table name for per-account usage counters (partition key: accountId)
DYNAMODB_TABLE_USAGE=

# DynamoDB table name for processed webhook event dedup records (partition
# key: eventId), used by Razorpay and Meta webhook idempotency checks
DYNAMODB_TABLE_WEBHOOK_EVENTS=

# DynamoDB table name for Razorpay payment history (partition key: accountId)
DYNAMODB_TABLE_PAYMENT_HISTORY=

# DynamoDB table name for the admin audit log (partition key: accountId, sort key: timestamp)
DYNAMODB_TABLE_AUDIT_LOG=

DYNAMODB_TABLE_VOICE_AGENTS=

# DynamoDB table name for voice call logs (partition key: agentId, sort key: callId)
DYNAMODB_TABLE_VOICE_CALL_LOGS=

# Razorpay API key ID (test mode: rzp_test_..., live mode: rzp_live_...).
# Read at module load in lib/razorpay.ts — since main/streaming/crawler
# Lambdas share one bundle that unconditionally imports the full route tree,
# this must be set on all three Lambdas or the missing one crashes at cold
# start, not just billing. See docs/RAZORPAY_GO_LIVE_TEST_PLAN.md.
RAZORPAY_KEY_ID=

# Razorpay API key secret, paired with RAZORPAY_KEY_ID above
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret, configured separately per mode (test/live)
# in the Razorpay dashboard's webhook settings — not the same value as
# RAZORPAY_KEY_SECRET. Verified lazily (only when a webhook actually
# arrives), not at module load, unlike RAZORPAY_KEY_ID/KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Plan ID for the Starter tier. Live and test mode have separate
# Plan objects in Razorpay — this must point to the live-mode plan ID once
# RAZORPAY_KEY_ID/KEY_SECRET are switched to live-mode keys.
RAZORPAY_PLAN_ID_STARTER=

# Razorpay Plan ID for the Growth tier (see RAZORPAY_PLAN_ID_STARTER note)
RAZORPAY_PLAN_ID_GROWTH=

# Razorpay Plan ID for the Agency tier (see RAZORPAY_PLAN_ID_STARTER note)
RAZORPAY_PLAN_ID_AGENCY=

# Zoho CRM OAuth app client ID (Zoho API Console, self-client or server-based app)
ZOHO_CLIENT_ID=

# Zoho CRM OAuth app client secret
ZOHO_CLIENT_SECRET=

# Redirect URI registered with the Zoho OAuth app, must match
# {BACKEND_URL}/api/integrations/zoho/callback
ZOHO_REDIRECT_URI=

# DynamoDB table name for Meta Lead Ads submissions (partition key: clientId, sort key: leadId, GSI: clientId-createdAt-index)
DYNAMODB_TABLE_META_LEADS=

# DynamoDB table name for the Meta pageId -> clientId webhook routing lookup (partition key: pageId)
DYNAMODB_TABLE_META_PAGE_LOOKUP=

# Meta App ID (developers.facebook.com) - shared by the Lead Ads OAuth
# connect flow and the WhatsApp Embedded Signup code exchange (same app,
# no separate WhatsApp-specific App ID needed)
META_APP_ID=

# Meta App Secret - same dual purpose as META_APP_ID above (Lead Ads OAuth
# token exchange + webhook/signed-request verification, and WhatsApp
# Embedded Signup's code exchange)
META_APP_SECRET=

# Redirect URI registered with the Meta app, must match
# {BACKEND_URL}/api/integrations/meta/callback
META_REDIRECT_URI=

# Verify token configured on the Meta app's webhook subscription (Lead Ads),
# used for the one-time GET handshake at {BACKEND_URL}/api/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=

# AWS Cognito User Pool ID used to verify JWTs on protected routes
COGNITO_USER_POOL_ID=

# AWS Cognito App Client ID used to verify JWTs on protected routes
COGNITO_CLIENT_ID=bia5g9e6gsb3h9n191rcvkugn

# AWS Cognito User Pool ID for the separate STAFF pool, used to verify JWTs
# on internal ops console routes (/api/admin/*) — never the customer pool
STAFF_COGNITO_USER_POOL_ID=

# AWS Cognito App Client ID for the STAFF pool
STAFF_COGNITO_CLIENT_ID=

# AWS region for the STAFF Cognito pool
STAFF_COGNITO_REGION=

# Origin allowed to call /api/admin/* (the internal ops console frontend),
# defaults to http://localhost:5173 for local dev if unset
ADMIN_CONSOLE_ORIGIN=

# URL of the deployed frontend, used for CORS configuration
FRONTEND_URL=

# Name of the main (buffered) AWS Lambda function to deploy to (used by the deploy script)
LAMBDA_FUNCTION_NAME=

# Name of the streaming AWS Lambda function (RESPONSE_STREAM mode) that handles
# /api/chat/message, deployed from the same build (used by the deploy script)
LAMBDA_STREAMING_FUNCTION_NAME=

# Port for the local dev server (defaults to 3000 if unset)
PORT=

# Node environment (development | production); local dev server only starts when not 'production'
NODE_ENV=


SQS_CRAWLER_QUEUE_URL=
